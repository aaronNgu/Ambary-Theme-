<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="s_ambary_experience" name="Ambary Experience">
    <section class="s_ambary_experience o_cc o_cc5 o_colored_level pt112 pb112"
             id="why-ambary" data-snippet="s_ambary_experience" data-name="Ambary Experience">
        <div class="container">
            <div class="row gy-5">
                <div class="col-lg-5" data-name="Introduction">
                    <p class="o_ambary_eyebrow s_ambary_experience_accent mb-4">Why Ambary</p>
                    <h2 class="s_ambary_experience_heading mb-4">From our greenhouse to your house.</h2>
                    <p class="s_ambary_experience_lead">We grow the hemp and make the products ourselves, keeping care and attention at every step.</p>
                    <div class="s_ambary_experience_actions d-flex flex-wrap align-items-center gap-4 mt-5">
                        <a href="/aboutus" class="btn btn-secondary rounded-pill">See how it's made <i class="fa fa-arrow-right ms-2" aria-hidden="true"/></a>
                    </div>
                </div>
                <div class="col-lg-6 offset-lg-1" data-name="Process">
                    <ol class="s_ambary_experience_steps list-unstyled mb-0">
                        <li class="s_ambary_experience_step" data-name="Process Step">
                            <span class="s_ambary_experience_number">01</span>
                            <div>
                                <h3 class="s_ambary_experience_step_heading">Grown in our own greenhouses</h3>
                                <p class="s_ambary_experience_description mb-0">Our team grows hemp year-round in Kittredge, Colorado, carefully managing the growing conditions at every stage.</p>
                            </div>
                        </li>
                        <li class="s_ambary_experience_step" data-name="Process Step">
                            <span class="s_ambary_experience_number">02</span>
                            <div>
                                <h3 class="s_ambary_experience_step_heading">Harvested with care</h3>
                                <p class="s_ambary_experience_description mb-0">Each plant is cut and hung to dry by hand. With fresh harvests every week, that hands-on attention continues throughout the year.</p>
                            </div>
                        </li>
                        <li class="s_ambary_experience_step" data-name="Process Step">
                            <span class="s_ambary_experience_number">03</span>
                            <div>
                                <h3 class="s_ambary_experience_step_heading">Made by us. Independently tested.</h3>
                                <p class="s_ambary_experience_description mb-0">Our lab team creates our products using oil extracted from our own hemp. Every batch is independently tested for cannabinoid potency, with results available for you to review.</p>
                                <div class="s_ambary_experience_links d-flex flex-wrap gap-4 mt-4">
                                    <a class="o_ambary_link_strong" href="/the-lab">Our lab <span class="ms-2" aria-hidden="true">↗</span></a>
                                    <a class="o_ambary_link_strong" href="/test-results">Test results <span class="ms-2" aria-hidden="true">↗</span></a>
                                </div>
                            </div>
                        </li>
                    </ol>
                </div>
            </div>
        </div>
    </section>
</template>
</odoo>
